#!/usr/bin/env bash
# locus-sudo: run locus with elevated privileges so block / unblock / focus
# can edit the hosts file. preserves $HOME so locus still reads your config from
# ~/.config/locus and not /root/.config/locus.

set -u

# resolve real paths so sudo's secure_path reset can't lose them.
# follow symlinks so the script works when linked into ~/.local/bin etc.
self="$(readlink -f -- "${BASH_SOURCE[0]}")"
script_dir="$(dirname -- "$self")"
node_bin="$(command -v node || true)"

if [[ -z "$node_bin" ]]; then
  echo "locus-sudo: 'node' not on PATH" >&2
  exit 1
fi

entry="$script_dir/dist/cli.js"

if [[ ! -f "$entry" ]]; then
  echo "locus-sudo: cannot find locus entry at $entry" >&2
  echo "  build it first: (cd $script_dir && npm run build)" >&2
  exit 1
fi

# WSL: sudo is the wrong tool — Windows ACLs gate the Windows hosts file,
# not Linux UID. Point users at the one-time setup instead.
if grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null \
   || grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease 2>/dev/null; then
  echo "locus-sudo: detected WSL." >&2
  echo "  on WSL, run 'locus setup' once (prompts UAC) to grant your Windows" >&2
  echo "  user write access to the hosts file. after that, just run 'locus'" >&2
  echo "  from any terminal — no sudo wrapper needed." >&2
  exit 1
fi

if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  exec "$node_bin" "$entry" "$@"
fi

exec sudo --preserve-env=HOME,LOCUS_HOSTS_PATH,LOCUS_NO_BROWSER_RESTART,DISPLAY,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DBUS_SESSION_BUS_ADDRESS,XAUTHORITY,XDG_SESSION_TYPE \
  "$node_bin" "$entry" "$@"
